generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model achievements {
  achievement_id    Int                 @id @default(autoincrement())
  name              String              @db.VarChar(100)
  description       String
  category          AchievementCategory
  rarity            ItemRarity
  icon_url          String              @db.VarChar(255)
  icon_locked_url   String?             @db.VarChar(255)
  badge_url         String?             @db.VarChar(255)
  points            Int                 @default(10)
  requirement_type  String              @db.VarChar(50)
  requirement_value Int
  reward_coins      Int?                @default(0)
  reward_gems       Int?                @default(0)
  reward_xp         Int?                @default(0)
  reward_title      String?             @db.VarChar(100)
  reward_item_id    Int?
  is_secret         Boolean?            @default(false)
  is_repeatable     Boolean?            @default(false)
  display_order     Int?                @default(0)
  created_at        DateTime            @default(now()) @db.Timestamp(6)
  user_achievements user_achievements[]

  @@index([category], map: "idx_achievements_category")
  @@index([display_order], map: "idx_achievements_order")
  @@index([rarity], map: "idx_achievements_rarity")
}

/// This table is a partition table and requires additional setup for migrations. Visit https://pris.ly/d/partition-tables for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model activity_logs {
  log_id        BigInt   @default(autoincrement())
  user_id       Int?
  action        String   @db.VarChar(100)
  ip_address    String?  @db.Inet
  user_agent    String?
  session_id    String?  @db.VarChar(255)
  resource_type String?  @db.VarChar(50)
  resource_id   Int?
  metadata      Json?
  created_at    DateTime @default(now()) @db.Timestamp(6)
  users         users?   @relation(fields: [user_id], references: [user_id], onUpdate: NoAction, map: "fk_activity_log_user")

  @@id([log_id, created_at])
  @@index([action, created_at(sort: Desc)], map: "idx_activity_logs_action")
  @@index([created_at(sort: Desc)], map: "idx_activity_logs_created")
  @@index([user_id, created_at(sort: Desc)], map: "idx_activity_logs_user")
}

