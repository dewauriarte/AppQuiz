/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model game_answers {
  answer_id        BigInt           @default(autoincrement())
  game_id          Int
  player_id        Int
  question_id      Int
  option_id        Int
  time_taken_ms    Int
  was_correct      Boolean
  points_earned    Int
  combo_multiplier Decimal?         @default(1.00) @db.Decimal(3, 2)
  powerup_used     String?          @db.VarChar(50)
  answered_at      DateTime         @default(now()) @db.Timestamp(6)
  games            games            @relation(fields: [game_id], references: [game_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_game_answers_game")
  question_options question_options @relation(fields: [option_id], references: [option_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_game_answers_option")
  game_players     game_players     @relation(fields: [player_id], references: [player_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_game_answers_player")
  questions        questions        @relation(fields: [question_id], references: [question_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_game_answers_question")

  @@id([answer_id, answered_at])
  @@index([was_correct, answered_at(sort: Desc)], map: "idx_game_answers_correct")
  @@index([game_id, answered_at(sort: Desc)], map: "idx_game_answers_game")
  @@index([player_id, answered_at(sort: Desc)], map: "idx_game_answers_player")
  @@index([question_id], map: "idx_game_answers_question")
}

